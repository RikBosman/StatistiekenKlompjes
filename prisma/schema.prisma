generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id             Int      @id
  name           String
  sku            String?
  cogs           Float?
  firstOrderDate DateTime?
  createdAt      DateTime
  status         String
  categories     String   // JSON array of category names
  syncedAt       DateTime @default(now())

  orderItems OrderItem[]

  @@map("products")
}

model Order {
  id             Int      @id
  date           DateTime
  customerId     Int?
  customerEmail  String
  customerName   String
  total          Float
  shippingTotal  Float
  shippingMethod String?  // WooCommerce shipping method title (e.g. "Brievenbuspakket")
  status         String
  syncedAt       DateTime @default(now())

  lineItems OrderItem[]
  customer  Customer?   @relation(fields: [customerId], references: [id])

  @@map("orders")
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int
  productId Int?
  name      String
  quantity  Int
  total     Float
  sku       String?

  order   Order    @relation(fields: [orderId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Customer {
  id        Int      @id
  email     String   @unique
  firstName String
  lastName  String
  tags      String   @default("[]") // JSON array of tags

  orders             Order[]
  reminders          Reminder[]
  listMemberships    CustomerListMember[]
  campaignRecipients CampaignRecipient[]

  @@map("customers")
}

model Reminder {
  id           Int      @id @default(autoincrement())
  customerId   Int
  campaign     String
  orderId      Int?
  triggeredAt  DateTime @default(now())
  sentAt       DateTime?
  scheduledFor DateTime?
  status       String   @default("pending") // pending, sent, failed

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("reminders")
}

model AdSpend {
  id         Int      @id @default(autoincrement())
  date       DateTime
  campaign   String
  campaignId String
  spend      Float
  clicks     Int      @default(0)
  impressions Int     @default(0)
  conversions Int     @default(0)

  @@unique([date, campaignId])
  @@map("ad_spend")
}

model EmailTemplate {
  id               Int      @id @default(autoincrement())
  name             String
  subject          String
  bodyHtml         String
  linkedProductIds String   @default("[]") // JSON array
  isDefault        Boolean  @default(false)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  campaigns Campaign[]

  @@map("email_templates")
}

model CustomerList {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  members   CustomerListMember[]
  campaigns Campaign[]

  @@map("customer_lists")
}

model CustomerListMember {
  listId     Int
  customerId Int
  addedAt    DateTime @default(now())

  list     CustomerList @relation(fields: [listId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([listId, customerId])
  @@map("customer_list_members")
}

model Campaign {
  id          Int       @id @default(autoincrement())
  name        String
  templateId  Int
  segmentType String?   // logo_buyer | inactive_3m | top_customers | list
  listId      Int?
  status      String    @default("draft") // draft | sent | failed
  totalSent   Int       @default(0)
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  template   EmailTemplate      @relation(fields: [templateId], references: [id])
  list       CustomerList?      @relation(fields: [listId], references: [id])
  recipients CampaignRecipient[]

  @@map("campaigns")
}

model CampaignRecipient {
  id         Int       @id @default(autoincrement())
  campaignId Int
  customerId Int
  email      String
  firstName  String
  status     String    @default("pending") // pending | sent | failed
  sentAt     DateTime?
  error      String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@map("campaign_recipients")
}

model SyncLog {
  id        Int      @id @default(autoincrement())
  type      String   // products, orders, ads, reminders
  status    String   // success, failed
  message   String?
  itemCount Int      @default(0)
  createdAt DateTime @default(now())

  @@map("sync_logs")
}

model Settings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}
