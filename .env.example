# Database
DATABASE_URL="file:./dev.db"

# WooCommerce REST API
WOOCOMMERCE_URL="https://yourstore.com"
WOOCOMMERCE_CONSUMER_KEY="ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WOOCOMMERCE_CONSUMER_SECRET="cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# SMTP — via lokale Exim (eigen server, geen daglimiet)
# Stuur via de Exim MTA die al op de server draait (poort 25, geen auth nodig)
SMTP_HOST="localhost"
SMTP_PORT="25"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="info@statistieken.klompjes.com"
SMTP_FROM_NAME="Klompjes"

# Of via DirectAdmin mailbox (max 200/dag):
# SMTP_HOST="mail.statistieken.klompjes.com"
# SMTP_PORT="587"
# SMTP_USER="info@statistieken.klompjes.com"
# SMTP_PASS="jouw_wachtwoord"

# Cron security key (protect /api/cron/* endpoints)
CRON_SECRET="change_this_to_a_random_secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# New product window (days)
NEW_PRODUCT_WINDOW_DAYS=60

# Reminder trigger (months)
REMINDER_MONTHS=3
