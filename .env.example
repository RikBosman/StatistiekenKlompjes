# Database
DATABASE_URL="file:./dev.db"

# WooCommerce REST API
WOOCOMMERCE_URL="https://yourstore.com"
WOOCOMMERCE_CONSUMER_KEY="ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WOOCOMMERCE_CONSUMER_SECRET="cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Mailtrap Sending API
MAILTRAP_API_TOKEN="your_mailtrap_api_token"
MAILTRAP_FROM_EMAIL="noreply@yourstore.com"
MAILTRAP_FROM_NAME="Your Store"

# Google Ads API (optional)
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""

# Cron security key (protect /api/cron/* endpoints)
CRON_SECRET="change_this_to_a_random_secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# New product window (days)
NEW_PRODUCT_WINDOW_DAYS=60

# Reminder trigger (months)
REMINDER_MONTHS=3
